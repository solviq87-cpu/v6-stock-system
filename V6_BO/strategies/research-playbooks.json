  "playbooks": [
    {
      "id": "platform_breakout",
      "label": "平台放量突破",
      "inputs": [
        "bars"
      ],
      "dataFrequency": "daily",
      "risk": "假突破"
    },
    {
      "id": "trend_pullback",
      "label": "多头趋势缩量回踩",
      "inputs": [
        "bars"
      ],
      "dataFrequency": "daily",
      "risk": "趋势反转"
    },
    {
      "id": "momentum_acceleration",
      "label": "动量加速",
      "inputs": [
        "bars"
      ],
      "dataFrequency": "daily",
      "risk": "追高回撤"
    },
    {
      "id": "low_vol_quality",
      "label": "低波动与质量共振",
      "inputs": [
        "bars",
        "roeQualityScore"
      ],
      "dataFrequency": "daily+fundamental",
      "risk": "财报滞后"
    },
    {
      "id": "first_board_quality",
      "label": "首板质量",
      "inputs": [
        "bars",
        "firstSealTime",
        "sealQualityScore"
      ],
      "dataFrequency": "daily+intraday",
      "risk": "涨停判定需交易所原始价与封板数据"
    },
    {
      "id": "first_to_second",
      "label": "一进二承接",
      "inputs": [
        "bars",
        "auctionQualityScore",
        "sectorHeatScore"
      ],
      "dataFrequency": "daily+auction",
      "risk": "隔夜跳空及不可成交"
    },
    {
      "id": "second_to_third",
      "label": "二进三强弱",
      "inputs": [
        "bars",
        "auctionQualityScore",
        "promotionScore"
      ],
      "dataFrequency": "daily+auction",
      "risk": "连板高波动"
    },
    {
      "id": "reseal_strength",
      "label": "炸板回封",
      "inputs": [
        "resealScore",
        "sealQualityScore"
      ],
      "dataFrequency": "intraday",
      "risk": "分时数据缺失"
    },
    {
      "id": "leader_sector",
      "label": "板块龙头共振",
      "inputs": [
        "leaderStrengthScore",
        "sectorHeatScore"
      ],
      "dataFrequency": "intraday",
      "risk": "题材快速退潮"
    },
    {
      "id": "money_flow_continuation",
      "label": "资金持续性",
      "inputs": [
        "moneyPersistenceScore",
        "fundFlowScore"
      ],
      "dataFrequency": "daily+flow",
      "risk": "资金统计口径差异"
    }
